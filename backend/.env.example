# Copy this file to .env and fill in your real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/aletheia

# Answers to questions (free key: aistudio.google.com). On the free tier Google
# may use the questions and passages to improve its products.
# GEMINI_API_KEY=your-key
# Optional: the main model, and the one tried when it is busy (defaults shown).
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_MODEL=gemini-2.5-flash

# Production only (HTTPS): send the session cookie over HTTPS only. Leave unset on your PC.
# COOKIE_SECURE=true
